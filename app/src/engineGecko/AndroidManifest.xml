<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:icon="@mipmap/ic_launcher_calls"
        android:roundIcon="@mipmap/ic_launcher_calls"
        android:label="@string/app_name_calls"
        tools:replace="android:icon,android:roundIcon,android:label">
        <activity-alias
            android:name=".LinkAlias"
            android:label="@string/app_name_calls"
            tools:replace="android:label" />
        <receiver
            android:name=".web.NotificationActionReceiver"
            android:exported="false" />
        <service
            android:name=".web.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
