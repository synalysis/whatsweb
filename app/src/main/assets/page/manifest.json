{
  "manifest_version": 2,
  "name": "WhatsWeb",
  "version": "1.0.19",
  "description": "Applies the phone layout to WhatsApp Web.",
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsweb@synalysis.com"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["host.js", "desktop_identity.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "host.js",
    "desktop_identity.js",
    "phone_layout.js"
  ]
}
