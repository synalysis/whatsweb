#!/usr/bin/env bash
# Tag the current commit as v<versionName> from app/build.gradle.kts.
# The release workflow only runs for tags of that form, and it checks the tag
# against the version baked into the APK. This script does not push.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

gradle=app/build.gradle.kts
version_name=$(sed -n 's/^[[:space:]]*versionName = "\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p' "$gradle")
version_code=$(sed -n 's/^[[:space:]]*versionCode = \([0-9][0-9]*\).*/\1/p' "$gradle")

if [ -z "$version_name" ] || [ -z "$version_code" ]; then
  echo "Could not read versionName and versionCode from $gradle." >&2
  echo "versionName has to look like 1.0.1 so the tag matches the release workflow." >&2
  exit 1
fi

tag="v$version_name"

if [ -n "$(git status --porcelain)" ]; then
  echo "The worktree has uncommitted changes. Commit them before tagging $tag." >&2
  exit 1
fi

head=$(git rev-parse HEAD)
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  existing=$(git rev-parse "$tag^{}")
  if [ "$existing" = "$head" ]; then
    echo "$tag already points at this commit."
    echo "Push it with: git push origin $tag"
    exit 0
  fi
  echo "$tag already points at ${existing:0:12}, not this commit (${head:0:12})." >&2
  echo "This script will not move an existing tag." >&2
  exit 1
fi

recipe=fdroid/com.synalysis.whatsweb.yml
if [ -f "$recipe" ]; then
  recipe_commit=$(sed -n 's/^[[:space:]]*commit:[[:space:]]*\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' "$recipe" | head -n 1)
  if [ -n "$recipe_commit" ] && [ "$recipe_commit" != "$tag" ]; then
    echo "Note: $recipe builds $recipe_commit, while this tag is $tag."
  fi
fi

git tag -a "$tag" -m "WhatsWeb $version_name"
echo "Tagged $tag (versionCode $version_code) at ${head:0:12}."
echo "Push it with: git push origin $tag"
